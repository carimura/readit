{
  "manifest_version": 3,
  "name": "Read It",
  "version": "0.1.0",
  "description": "Reads the current page or selected text aloud using your TTS provider.",
  "permissions": ["activeTab", "scripting", "storage", "offscreen"],
  "host_permissions": ["https://api.elevenlabs.io/*", "https://api.cloudflare.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Read It",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
